{
	"name": "ds_adlsstorage",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_adlsstorage",
			"type": "LinkedServiceReference",
			"parameters": {
				"l_account_url": {
					"value": "concat('https://adlsstorage',dataset().d_container,'.dfs.core.windows.net/')",
					"type": "Expression"
				},
				"l_account_key": {
					"value": "concat('secrets-adls-',dataset().d_container,'-key')",
					"type": "Expression"
				}
			}
		},
		"parameters": {
			"d_container": {
				"type": "String"
			},
			"d_batch_run_date": {
				"type": "String"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().d_container,'_',dataset().d_batch_run_date,'.csv')",
					"type": "Expression"
				},
				"fileSystem": "raw"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}